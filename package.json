{
  "name": "vynixforge-launcher",
  "version": "1.0.0",
  "description": "Minecraft launcher generated by VynixForge",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.vynixstudio.launcher",
    "productName": "VynixForge Launcher",
    "win": {
      "target": "nsis"
    },
    "files": [
      "src/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.17.3"
  }
}
