# ============================================================
# Copy this to .env and fill in real values before deploying.
# Never commit the real .env file.
# ============================================================

# --- Core ---
PORT=3000
NODE_ENV=production
APP_URL=https://your-real-domain.com
SESSION_SECRET=generate-a-long-random-string-here

# --- Owner (CRITICAL) ---
# Your GitHub numeric user ID -- NOT your username. Find it at:
#   https://api.github.com/users/YOUR_GITHUB_USERNAME
# (look for the "id" field in the JSON response)
# If this is unset, blank, or wrong, NOBODY becomes Owner -- that is the
# intended safe failure mode. There is no fallback and no "first user"
# special-case anywhere in this codebase.
OWNER_USER_ID=

# --- GitHub OAuth App ---
# Create one at https://github.com/settings/developers -> "New OAuth App"
# Authorization callback URL must exactly match GITHUB_CALLBACK_URL below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://your-real-domain.com/auth/github/callback

# --- Stripe (billing) ---
# From https://dashboard.stripe.com/apikeys and /webhooks
# Until these are set, /api/billing/checkout/* correctly returns a clear
# "not configured" error instead of faking a successful purchase.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create two real recurring Prices in Stripe (one $4.99/mo, one $9.99/mo)
# and paste their price IDs here (starts with "price_").
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_DEV=
# Optional: real second Stripe Prices if you want actual BDT checkout
# (without these, BDT is display-only and checkout refuses clearly)
STRIPE_PRICE_ID_PRO_BDT=
STRIPE_PRICE_ID_DEV_BDT=
